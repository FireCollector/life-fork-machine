ZHIHU_ACCESS_SECRET=

# Optional: the official CLI location. On Windows, the server automatically
# detects %LOCALAPPDATA%/ZhihuCLI/current/zhihu-cli.exe when this is blank.
# Never put an Access Secret in this file.
ZHIHU_CLI_PATH=

# TASK-030: server-only AI gateway. Keep this file unfilled and never prefix
# these variables with NEXT_PUBLIC_. Without all three values, the app stays in
# transparent "demo cache" mode and no provider request is sent.
# Supported: openai, deepseek. Each uses its documented Responses API.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# Use the provider base URL. The server safely appends /responses when needed.
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=10
AI_CACHE_TTL_MS=300000
AI_CACHE_MAX_ENTRIES=100
AI_PROMPT_VERSION=task-030.v1
