ZHIHU_ACCESS_SECRET=

# TASK-030: server-only AI gateway. Keep this file unfilled and never prefix
# these variables with NEXT_PUBLIC_. Without all three values, the app stays in
# transparent "demo cache" mode and no provider request is sent.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1/responses
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=10
AI_CACHE_TTL_MS=300000
AI_CACHE_MAX_ENTRIES=100
AI_PROMPT_VERSION=task-030.v1
